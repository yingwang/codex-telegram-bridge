{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "send": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "maxLength": 220
    },
    "next_delay_minutes": {
      "type": "integer",
      "minimum": 30,
      "maximum": 720
    }
  },
  "required": [
    "send",
    "message",
    "next_delay_minutes"
  ]
}
